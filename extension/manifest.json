{
  "manifest_version": 3,
  "name": "ACGME Case Submitter",
  "description": "Submit saved case log entries to ACGME ADS automatically",
  "version": "1.4.4",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://apps.acgme.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://apps.acgme.org/*"],
      "js": ["content.js"]
    }
  ]
}
